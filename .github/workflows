name: Auto Update Room Status

on:
  schedule:
    - cron: '0 * * * *'
  workflow_dispatch:  

permissions:
  contents: write 

jobs:
  scrape-and-update:
    runs-on: ubuntu-latest

    steps:
    - name: 1. 檢出專案程式碼
      uses: actions/checkout@v4
      with:
        persist-credentials: true

    - name: 2. 初始化 Python 環境
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: 3. 安裝爬蟲套件
      run: |
        python -m pip install --upgrade pip
        pip install requests beautifulsoup4

    - name: 4. 執行自動化人頭數數腳本
      run: python update_rooms.py

    - name: 5. 自動推送 rooms.json 狀態
      run: |
        git config --local user.email "action@github.com"
        git config --local user.name "GitHub Action Bot"
        git add rooms.json
        
        if ! git diff --cached --exit-code; then
          git commit -m "chore: 自動更新房間狀態 JSON [skip ci]"
          git push "https://${{ secrets.GITHUB_TOKEN }}@github.com/${{ github.repository }}.git" HEAD:main
          echo "🎉 狀態更新成功！"
        else
          echo "☕ 狀態無改變，跳過推送。"
        fi
